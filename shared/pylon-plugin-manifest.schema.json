{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pylon.local/schemas/pylon-plugin-manifest.schema.json",
  "title": "Pylon plugin manifest (pylon-plugin.json)",
  "description": "Plugin API 1.0/1.1/1.2/1.3/2.0 包清单。本 schema 比宿主解析器更严格（additionalProperties: false）——用于编辑器补全与 CI 校验；宿主本身忽略未知字段。capabilities 仅 API 1.2 允许（封闭词表）。真值规则见 src/plugin-runtime/packageManifest.ts。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "api", "kind", "web"],
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "description": "点分小写命名（如 starter.hello）"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "api": { "enum": ["1.0", "1.1", "1.2", "1.3", "2.0", "2.1", "2.2", "2.3", "2.4"], "description": "目标 Plugin API 小版本；宿主按 allowlist 接受（1.0 插件在 1.1/1.2/1.3 宿主继续激活；2.0 为破坏性主轴，左栏贡献改按 region 注册；2.1 新增标题栏设置菜单项贡献；2.2 右栏面板的种类改为亲和而非闸门；2.3 新增会话置顶；2.4 命令描述符新增可选检索词 keywords 与可见性档 tier）" },
    "kind": {
      "enum": [
        "shell", "workspace", "feature", "hook", "renderer",
        "skin", "agent-adapter", "tool-provider", "service", "automation"
      ]
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry"],
      "properties": {
        "entry": { "type": "string", "minLength": 1, "description": "单文件 ESM bundle 相对路径" },
        "styles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "executables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "type": "string" }
      }
    },
    "dependencies": { "$ref": "#/definitions/versionRanges" },
    "optionalDependencies": { "$ref": "#/definitions/versionRanges" },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events"],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hotSwap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["parallel", "exclusive", "soft-remount", "restart-required"] },
        "drainTimeoutMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "reactVersion": { "type": "string", "description": "@deprecated 别名（仅为第三方/历史 manifest 保留）：第一方宿主是 Solid，UI 运行时元数据的正规形态是 PluginUiSurface 的 runtime: { framework, version }；第一方 manifest 不应携带本字段" },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["plugin.management"] },
      "description": "API 1.2 起合法（1.3 沿用）：声明的宿主能力（封闭词表，宿主 fail-closed 拒绝未知项）；1.0/1.1 manifest 携带该字段会被宿主拒绝"
    },
    "dangerousHooks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "description": "API 1.2 起合法（1.3 扩充锚点词表）：声明需用户确认的危险 Hook 锚点；1.0/1.1 携带该字段会被宿主拒绝"
    }
  },
  "definitions": {
    "versionRanges": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:\\*|\\^?\\d+\\.\\d+\\.\\d+)$",
        "description": "exact / caret / * 三种范围"
      }
    }
  }
}
